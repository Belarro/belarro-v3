// Belarro v3 — Farm Management System (CLEAN REBUILD)
// Database Schema (Prisma ORM) — Mapped to Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CROPS (THE CORE)
// ============================================

model Crop {
  id                String   @id @default(cuid())
  name_en           String
  name_de           String
  flavor            String?
  status            String   @default("active") // "active" | "paused"

  // Relations
  growth_procedure  GrowthProcedure?
  variants          ProductVariant[]

  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  deleted_at        DateTime? // Soft delete

  @@map("belarro_v3_crop")
  @@index([status])
  @@index([deleted_at])
}

// ============================================
// GROWTH PROCEDURE (LINEAR SEQUENCE PER CROP)
// ============================================

model GrowthProcedure {
  id                      String   @id @default(cuid())
  crop_id                 String   @unique

  // Linear sequence
  soak_enabled            Boolean  @default(false)
  soak_hours              Int?     // If soak_enabled, required

  // Seed is always present, no options

  cover_soil_enabled      Boolean  @default(false)

  stack_enabled           Boolean  @default(false)
  stack_days              Int?     // If stack_enabled, required

  // Growth environment (mutually exclusive)
  growth_env_type         String   // "blackout" | "light" | "humidity_dome"
  growth_env_days         Int      // Duration of growth environment

  // Light + Humidity Dome variant (concurrent, not sequential)
  humidity_dome_enabled   Boolean  @default(false) // Only if growth_env_type is "light"

  // Relations
  crop                    Crop     @relation(fields: [crop_id], references: [id], onDelete: Cascade)

  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  @@map("belarro_v3_growth_procedure")
}

// ============================================
// PRODUCT VARIANTS (SIZES & PRICES)
// ============================================

model ProductVariant {
  id                String   @id @default(cuid())
  crop_id           String
  size_name         String   // "100g", "225g", "450g", "Container"
  size_grams        Float    // Actual grams (for Container: 30g internal value)
  price_eur         Float

  // Relations
  crop              Crop     @relation(fields: [crop_id], references: [id], onDelete: Cascade)

  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@map("belarro_v3_product_variant")
  @@index([crop_id])
  @@unique([crop_id, size_name]) // One size per crop
}

// ============================================
// AUDIT LOG (DATA PROTECTION)
// ============================================

model AuditLog {
  id          String   @id @default(cuid())
  action      String   // "CREATE" | "UPDATE" | "DELETE"
  entity_type String   // "Crop" | "GrowthProcedure" | "ProductVariant"
  entity_id   String   // ID of the changed record
  old_values  String?  // JSON string of previous values
  new_values  String?  // JSON string of new values
  reason      String?

  created_at  DateTime @default(now())

  @@map("belarro_v3_audit_log")
  @@index([entity_type])
  @@index([entity_id])
}
